<div class="py-12 px-4 md:px-6 2xl:px-0 2xl:container 2xl:mx-auto">
  <div class="flex flex-col items-start w-full space-y-8">
    <div class="flex justify-start items-start">
      <p class="text-3xl lg:text-4xl font-bold leading-7 lg:leading-9 text-gray-800 ">
        What our customers are saying
      </p>
    </div>
    <!-- Grid 2 cột -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full">
      <% if reviews.present? %>
        <% reviews.each do |review| %>
          <div class="bg-white dark:bg-gray-800 p-8 flex flex-col space-y-4 rounded-xl shadow-md transition duration-300">
            <!-- Stars -->
            <div class="flex items-center space-x-1">
              <% review.star.times do %>
                <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M10 15l-5.878 3.09L5.64 11.545 1 7.91l6.06-.878L10 2l2.94 5.03L19 7.91l-4.64 3.636 1.518 6.545z"/>
                </svg>
              <% end %>
              <% (5-review.star).times do %>
                <svg class="w-5 h-5 text-white-400" fill="white" viewBox="0 0 20 20">
                  <path d="M10 15l-5.878 3.09L5.64 11.545 1 7.91l6.06-.878L10 2l2.94 5.03L19 7.91l-4.64 3.636 1.518 6.545z"/>
                </svg>
              <% end %>
            </div>
            <!-- Comment -->
            <p class="text-sm text-gray-600 dark:text-gray-300"><%= review.comment %></p>
            <!-- Reviewer info -->
            <div class="flex items-center space-x-4 mt-4">
              <img class="w-10 h-10 rounded-full" src="https://i.ibb.co/QcqyrVG/Mask-Group.png" alt="avatar">
              <div>
                <p class="text-sm font-medium text-gray-800 dark:text-white"><%= review.user.name %></p>
                <p class="text-xs text-gray-500 dark:text-gray-400">
                  <%= review.created_at.strftime("%d/%m/%Y %H:%M") %>
                </p>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
