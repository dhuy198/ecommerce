<div class="container mx-auto my-10">
  <h1 class="text-3xl font-bold mb-8">Cart</h1>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
    <!-- Danh sách sản phẩm -->
    <div class="md:col-span-2">
      <% if @cart.cart_items.any? %>
        <div class="space-y-6">
          <% @cart.cart_items.each do |item| %>
            <div class="grid grid-cols-12 gap-4 items-center p-4 border border-gray-200 rounded-xl shadow-sm bg-white">
              <!-- Image -->
              <div class="col-span-2">
                <%= image_tag item.product.images.first, class: "w-20 h-20 object-cover rounded-lg shadow" %>
              </div>
              <!-- Product Name + Price -->
              <div class="col-span-4">
                <div class="font-semibold text-gray-800 text-base"><%= item.product.name %></div>
                <div class="text-gray-500 text-sm mt-1">$<%= '%.2f' % item.product.price %></div>
              </div>
              <!-- Quantity -->
              <div class="col-span-3">
                <div 
                  class="inline-flex items-center border border-gray-300 rounded-full px-4 py-1 bg-white"
                  data-controller="quantity"
                  data-cart-item-id="<%= item.id %>"
                  data-item-quantity="<%= item.quantity %>"
                  data-stock="<%= item.product.stock%>"
                >
                  <button
                  class="px-3 text-lg text-gray-600 hover:text-black"
                  data-action="click->quantity#down"
                    >-</button>
                  <span id="sl-<%= item.id %>" class="px-4 text-sm text-gray-800">
                    <%= item.quantity %>
                  </span>
                  <button
                  class="px-3 text-lg text-gray-600 hover:text-black"
                  data-action="click->quantity#up"
                    >+</button>
                </div>
              </div>
              <!-- Subtotal -->
              <div class="col-span-2 text-sm text-gray-800 font-medium">
                $<%= '%.2f' % (item.product.price * item.quantity) %>
              </div>
              <!-- Remove -->
              <div class="col-span-1 text-right">
                <%= button_to cart_item_path(item), method: :delete,id:"del-#{item.id}", class: "text-gray-400 pr-4 text-sm cursor-pointer" do %>
                  <i class="fas fa-trash"></i>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
        <!-- Shipping Information -->
        <div class=" my-10">
          <div class="bg-white rounded-2xl shadow-lg p-8 w-full  mx-auto border border-gray-200">
            <h2 class="text-2xl font-bold text-gray-800 mb-6">Shipping Information</h2>
            <% if current_user.shipping_information&.fully? %>
              <div class="space-y-4 text-gray-700">
                <div><strong>Full Name:</strong> <%= current_user.shipping_information.full_name %></div>
                <div><strong>Phone:</strong> <%= current_user.shipping_information.phone_number %></div>
                <div><strong>Address:</strong> <%= current_user.shipping_information.address %>, <%= current_user.shipping_information.district %>, <%= current_user.shipping_information.city %>, <%= current_user.shipping_information.country %></div>
                <div><strong>Postal Code:</strong> <%= current_user.shipping_information.postal_code %></div>
              </div>
            <% end %>
            <div class="mt-6">
              <%= render 'carts/modal', shipping_information: current_user.shipping_information %>
            </div>
          </div>
          <!-- Payment -->
          <div data-controller="payment" class="my-10 ">
            <h1 class="text-xl font-semibold mb-4">Pay with</h1>
            <div class="flex items-center space-x-6 bg-white rounded-2xl shadow-lg p-8 w-full border border-gray-200">
              <div class="flex items-center space-x-2">
                <input
                  type="radio"
                  name="payment_method"
                  value="card"
                  id="card"
                  data-action="payment#toggle"
                  class="w-5 h-5 text-[#23403D] focus:ring-[#23403D] border-gray-300"
                  checked
                >
                  <label for="card" class="text-sm font-medium text-gray-700">Card</label>
                </div>
                <div class="flex items-center space-x-2">
                  <input
                    type="radio"
                    name="payment_method"
                    value="cod"
                    id="cod"
                    data-action="payment#toggle"
                    class="w-5 h-5 text-[#23403D] focus:ring-[#23403D] border-gray-300"
                  >
                    <label for="cod" class="text-sm font-medium text-gray-700">COD</label>
                  </div>
                </div>
                <div class="mt-8 text-right <%= current_user.shipping_information.present? ? '' : 'hidden' %>">
                  <!-- cod -->
                  <div data-payment-target="codForm" class="hidden">
                    <button class="bg-[#23403D] hover:bg-[#2f5c57] text-white text-[16px] font-medium px-6 py-4 rounded-full transition duration-200"
                      data-controller="order"
                      data-action="click->order#make"
                      data-user-id="<%= current_user.id%>"
                      >
                      Create Order
                    </button>
                  </div>
                  <!--pay card-->
                  <div data-payment-target="cardForm">
                    <%= form_with url: payments_path(
                    cart_id: @cart.id, 
                    user_id: @current_user.id,
                    total: @total
                  ), method: :post do |form| %>
                      <%= form.submit "Confirm and Pay", class: "bg-[#23403D] hover:bg-[#2f5c57] text-white text-[16px] font-medium px-6 py-4 rounded-full transition duration-200"%>
                    <% end %>
                  </div>
                </div>
                <!-- Continue Shopping -->
                <div class="mt-8">
                  <%= link_to "Continue shopping", products_path, class: "inline-block bg-white border border-gray-300 hover:border-gray-400 text-gray-700 px-6 py-2 rounded-full shadow-sm transition" %>
                </div>
              <% else %>
                <div class="text-center text-gray-500 mt-6">
                  <p>Your cart is empty.</p>
                  <%= link_to "Continue shopping", products_path, class: "text-blue-500 hover:text-blue-600 underline" %>
                </div>
              <% end %>
            </div>
            <!-- Cart Totals -->
          </div>
        </div>
        <% if @cart.cart_items.sum { |item| item.product.price * item.quantity } > 0 %>
          <div class="border border-gray-200 rounded-xl p-8 shadow-sm bg-white h-fit md:col-span-1 cols-span-1">
            <h2 class="text-xl font-semibold mb-6 text-gray-800">Cart totals</h2>
            <div class="flex justify-between mb-3 text-sm text-gray-600">
              <span>Subtotal</span>
              <span>$<%= '%.2f' % @cart.cart_items.sum { |item| item.product.price * item.quantity } %></span>
            </div>
            <div class="flex justify-between text-base font-bold text-gray-800 mb-6">
              <span>Total</span>
              <span>$<%= '%.2f' % @cart.cart_items.sum { |item| item.product.price * item.quantity } %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
