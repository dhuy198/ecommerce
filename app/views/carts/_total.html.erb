<% if @cart.total > 0 %>
  <div class="border border-gray-200 rounded-xl p-8 shadow-sm bg-white h-fit md:col-span-1 cols-span-1">
    <h2 class="text-xl font-semibold mb-6 text-gray-800">Cart Totals</h2>
    <!-- Subtotal -->
    <div class="flex justify-between mb-3 text-sm text-gray-600">
      <span>Subtotal</span>
      <span id="total1"><%= number_to_currency(@cart.total) %></span>
    </div>
    <!-- Tax -->
    <% if @taxes.last.present? %>
      <div class="flex justify-between mb-3 text-sm text-gray-600">
        <span><%= @taxes.last.name %> (<%= @taxes.last.value %>%)</span>
        <span id="tax" data-tax="<%=@taxes.last.value%>"><%= number_to_currency(@cart.total * @taxes.last.value / 100) %></span>
      </div>
      <!-- Divider -->
      <hr class="my-4">
      <!-- Total -->
      <div class="flex justify-between text-base font-bold text-gray-800 mb-6">
        <span>Total</span>
        <span id="total2"><%= number_to_currency(@cart.total * (100 + @taxes.last.value )/ 100) %></span>
      </div>
    <% end %>
  </div>
<% end %>