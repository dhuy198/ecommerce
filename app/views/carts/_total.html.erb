<% if @cart.total > 0 %>
  <div class="border border-gray-200 rounded-2xl p-6 shadow-md bg-white h-fit md:col-span-1 cols-span-1">
    <!-- Heading -->
    <h2 class="text-2xl font-bold mb-6 text-gray-800 border-b pb-2">Cart Totals</h2>
    <!-- Subtotal -->
    <div class="flex justify-between mb-4 text-sm text-gray-700">
      <span class="font-medium">Subtotal</span>
      <span id="total1" class="font-semibold text-gray-900"><%= number_to_currency(@cart.total) %></span>
    </div>
    <% tong = @cart.total %>
    <!-- Tax -->
    <% if @taxes.last.present? %>
      <% tong += @taxes.last.value * tong / 100 %>
      <div class="flex justify-between mb-4 text-sm text-gray-700">
        <span class="font-medium"><%= @taxes.last.name %> (<%= @taxes.last.value %>%)</span>
        <span id="tax" data-tax="<%= @taxes.last.value %>" class="font-semibold text-gray-900">
          <%= number_to_currency(@cart.total * @taxes.last.value / 100) %>
        </span>
      </div>
      <hr class="my-4 border-gray-300">
    <% end %>
    <!-- Coupon input -->
    <div class="mb-6">
      <label for="coupon_code" class="block text-sm font-semibold text-gray-700 mb-2">Coupon Code</label>
      <div class="flex" data-controller="coupon" data-total="<%= @cart.total%>">
        <input type="text" id="coupon_code" name="coupon_code"
               class="flex-1 border border-gray-300 rounded-l-lg px-3 py-2 text-sm focus:outline-none"
               placeholder="Enter your coupon">
        <button type="button" id="apply_coupon" data-action="click->coupon#add"
          class="bg-[#23403D] text-white px-4 py-2 rounded-r-lg text-sm font-medium hover:bg-[#152400] transition">
          Apply
        </button>
      </div>
      <p id="coupon_message" class="text-xs mt-2 text-red-500 hidden"></p>
      <div id="mgg">  </div>
    </div>
    <!-- Total -->
    <div class="flex justify-between text-lg font-bold text-gray-900 bg-gray-50 p-3 rounded-lg">
      <span>Total</span>
      <span id="total2"><%= number_to_currency(tong) %></span>
    </div>
  </div>
<% end %>
