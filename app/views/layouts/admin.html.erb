<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin</title>
    <meta name="author" content="David Grzyb">
    <meta name="description" content="">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= javascript_importmap_tags %>
    <!-- Tailwind -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
    <style>
      @import url('https://fonts.googleapis.com/css?family=Karla:400,700&display=swap');
      .font-family-karla { font-family: karla; }
      .bg-sidebar { background: #3d68ff; }
      .cta-btn { color: #3d68ff; }
      .upgrade-btn { background: #1947ee; }
      .upgrade-btn:hover { background: #0038fd; }
      .active-nav-link { background: #1947ee; }
      .nav-item:hover { background: #1947ee; }
      .account-link:hover { background: #3d68ff; }
    </style>
  </head>
  <body class="bg-gray-100 font-family-karla flex h-full">
    <aside class="relative bg-sidebar h-full h-screen w-64 hidden sm:block shadow-xl">
      <div class="p-6">
        <%= link_to 'Admin', admin_root_path, class: "text-white text-3xl font-semibold uppercase hover:text-gray-300" %>
      </div>
      <nav class="text-white text-base font-semibold pt-3">
        <%= link_to 'Dashboard', admin_root_path, class: "flex items-center active-nav-link text-white py-4 pl-6 nav-item" %>
        <%= link_to "Users", admin_users_path, class: "flex items-center active-nav-link text-white py-4 pl-6 nav-item" %>
        <%= link_to "Orders", admin_orders_path, class: "flex items-center active-nav-link text-white py-4 pl-6 nav-item" %>
        <%= link_to "Categories", admin_categories_path, class: "flex items-center active-nav-link text-white py-4 pl-6 nav-item" %>
        <%= link_to "Products", admin_products_path, class: "flex items-center active-nav-link text-white py-4 pl-6 nav-item" %>
        <%= link_to "Reviews", admin_reviews_path, class: "flex items-center active-nav-link text-white py-4 pl-6 nav-item" %>
        <%= link_to "Taxes", admin_taxes_path, class: "flex items-center active-nav-link text-white py-4 pl-6 nav-item" %>
      </nav>
    </aside>
    <%=yield%>
  </body>
</html>