<!-- component -->
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
  </head>
  <body class="bg-gray-100 text-gray-800">
    <div class="flex justify-between min-h-screen">
      <!-- Sidebar -->
      <aside class="w-64 bg-white shadow-md">
        <div class="p-6 text-2xl font-bold border-b">Admin</div>
        <nav class="mt-4">
          <%= link_to "Users", admin_users_path, class: "block px-6 py-3 hover:bg-gray-100" %>
          <%= link_to "Orders", admin_orders_path, class: "block px-6 py-3 hover:bg-gray-100" %>
          <%= link_to "Categories", admin_categories_path, class: "block px-6 py-3 hover:bg-gray-100" %>
          <%= link_to "Products", admin_products_path, class: "block px-6 py-3 hover:bg-gray-100" %>
          <%= link_to "Reviews", admin_reviews_path, class: "block px-6 py-3 hover:bg-gray-100" %>
          <%= link_to "Taxes", admin_taxes_path, class: "block px-6 py-3 hover:bg-gray-100" %>
          <%= button_to "Log out", destroy_admin_session_path, method: :delete, class: "block px-6 py-3 hover:bg-gray-100"%>
        </nav>
      </aside>
      <!-- Main Content -->
      <main class="flex-1 p-6">
        <header class="text-xl font-semibold mb-4">Admin Controller</header>
        <%= yield %>
      </main>
    </div>
  </body>
