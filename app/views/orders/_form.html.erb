<%= form_with model: @order, remote: true, class: "max-w-lg mx-auto bg-white shadow-md rounded-lg p-6 space-y-4" do |f| %>
  <h2 class="text-2xl font-semibold mb-4 text-center">Add Address</h2>
  <div>
    <%= f.label :gname, "Full Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :gname, required: true, class: "w-full px-4 py-2 border rounded-lg focus:ring focus:ring-indigo-200" %>
  </div>
  <div>
    <%= f.label :gemail, "Email", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.email_field :gemail, required: true, class: "w-full px-4 py-2 border rounded-lg focus:ring focus:ring-indigo-200" %>
  </div>
  <div>
    <%= f.label :gphone, "Phone Number", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.telephone_field :gphone, required: true, class: "w-full px-4 py-2 border rounded-lg focus:ring focus:ring-indigo-200" %>
  </div>
  <div>
    <%= f.label :gaddress, "Address", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :gaddress, required: true, class: "w-full px-4 py-2 border rounded-lg focus:ring focus:ring-indigo-200" %>
  </div>
  <div>
    <%= f.label :gcity, "City", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :gcity, required: true, class: "w-full px-4 py-2 border rounded-lg focus:ring focus:ring-indigo-200" %>
  </div>
  <div>
    <%= f.label :gcountry, "Country", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :gcountry, required: true, class: "w-full px-4 py-2 border rounded-lg focus:ring focus:ring-indigo-200" %>
  </div>
  <!-- Hidden field để chứa cart -->
  <%= hidden_field_tag :cart_items, "", id: "cart-items-field" %>
  <div class="text-center pt-4">
    <%= f.submit "Place Order", class: "w-full bg-[#150420] text-white font-semibold py-2 px-4 rounded-lg transition duration-150" %>
  </div>
<% end %>
<script>
  document.addEventListener("turbo:load", () => {
    const cart = localStorage.getItem("cart") || "[]";
    document.getElementById("cart-items-field").value = cart;
  });
</script>