<% content_for :title, "Order details ##{@order.id}" %>
<div class="min-h-screen bg-white px-4">
  <div class="max-w-4xl mx-auto bg-white shadow-2xl rounded-3xl p-8 ">
    <h1 class="text-4xl font-bold text-teal-800 mb-6 flex items-center gap-3">
      Order #<%= @order.id %>
    </h1>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8 text-gray-800 text-base">
      <div class="space-y-3">
        <p><span class="text-sm text-gray-500 uppercase tracking-wide">Order ID:</span><br>
          <span class="text-lg font-semibold text-teal-800"><%= @order.id %></span>
        </p>
        <p><span class="text-sm text-gray-500 uppercase tracking-wide">Payment Status:</span><br>
          <span class="text-lg font-semibold <%= @order.payment_status == "paid" ? 'text-green-600' : 'text-red-600' %>">
            <%= @order.payment_status.capitalize %>
          </span>
        </p>
        <p><span class="text-sm text-gray-500 uppercase tracking-wide">Delivery Status:</span><br>
          <span class="text-lg font-semibold text-indigo-600"><%= @order.deliverd_status&.capitalize || "N/A" %></span>
        </p>
        <p><span class="text-sm text-gray-500 uppercase tracking-wide">Payment Method:</span><br>
          <span class="text-lg font-medium text-gray-700"><%= @order.payment_method.capitalize || "N/A" %></span>
        </p>
      </div>
      <div class="space-y-3">
        <p><span class="text-sm text-gray-500 uppercase tracking-wide">Order Date:</span><br>
          <span class="text-lg font-medium text-gray-700"><%= @order.created_at.strftime("%d/%m/%Y %H:%M") %></span>
        </p>
        <p><span class="text-sm text-gray-500 uppercase tracking-wide">Shipping Address:</span><br>
          <span class="text-lg font-medium text-gray-700"><%= @order.shipping_address || "N/A" %></span>
        </p>
        <p><span class="text-sm text-gray-500 uppercase tracking-wide">Total:</span><br>
          <span class="text-2xl font-bold text-gray-700"><%= number_to_currency(@order.total) %></span>
        </p>
      </div>
    </div>
    <h2 class="text-2xl font-semibold text-gray-700 mb-4 border-b pb-1">Products</h2>
    <div class="divide-y divide-gray-200">
      <% @order.order_items.each do |item| %>
        <div class="flex items-center py-4">
          <div class="w-16 h-16 bg-white border border-gray-300 rounded-lg shadow-sm flex items-center justify-center overflow-hidden mr-4">
            <% if item.product.images.attached? %>
              <%= image_tag item.product.images.first, class: "w-full h-full object-contain p-1" %>
            <% else %>
              <div class="w-full h-full bg-gray-100 text-gray-400 flex items-center justify-center text-xs">
                No Image
              </div>
            <% end %>
          </div>
          <div class="flex-1">
            <p class="text-gray-900 font-medium text-lg"><%= item.product.name %></p>
            <p class="text-sm text-gray-500">Quantity: <%= item.quantity %></p>
            <p class="text-sm text-gray-500">Price: <%= number_to_currency(item.price) %></p>
          </div>
          <div class="text-right font-semibold text-gray-600 text-lg">
            <%= number_to_currency(item.price * item.quantity) %>
          </div>
        </div>
      <% end %>
    </div>
    <div class="mt-10 text-right">
      <%= link_to "← Back to Orders", orders_path, class: "inline-block text-sm font-semibold text-white bg-[#23403D] hover:bg-teal-700 px-5 py-2 rounded-xl transition" %>
    </div>
  </div>
</div>
