<div id="shipping-form" data-controller="shipping">
  <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-md hidden" data-shipping-target="errors"></div>
  <div class="container mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
        <input data-shipping-target="name" type="text" class="w-full px-4 py-3 border rounded-xl" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
        <input data-shipping-target="phone" type="tel" class="w-full px-4 py-3 border rounded-xl" />
      </div>
      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-gray-700 mb-1">Address</label>
        <input data-shipping-target="address" type="text" class="w-full px-4 py-3 border rounded-xl" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">City</label>
        <input data-shipping-target="city" type="text" class="w-full px-4 py-3 border rounded-xl" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">District</label>
        <input data-shipping-target="district" type="text" class="w-full px-4 py-3 border rounded-xl" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Postal Code</label>
        <input data-shipping-target="postal" type="text" class="w-full px-4 py-3 border rounded-xl" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Country</label>
        <input data-shipping-target="country" type="text" class="w-full px-4 py-3 border rounded-xl" />
      </div>
    </div>
  </div>
  <div class="pt-6 flex justify-end gap-4">
    <button data-action="click->shipping#send" class="px-4 py-2 text-white bg-[#152420] hover:bg-[#0f1a17] rounded-md">
      Save
    </button>
    <button type="button" command="close" commandfor="dialog" class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50 sm:mt-0 sm:w-auto">Cancel</button>
  </div>
</div>
