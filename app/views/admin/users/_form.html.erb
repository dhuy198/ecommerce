<%= form_with model: [:admin, user], local: true, class: "space-y-6" do |f| %>
  <% if user.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative">
      <strong class="font-bold">Errors:</strong>
      <ul class="list-disc pl-5 mt-2">
        <% user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= f.label :name, class: "block text-gray-700 text-sm font-bold mb-2" %>
    <%= f.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>
  <div>
    <%= f.label :email, class: "block text-gray-700 text-sm font-bold mb-2" %>
    <%= f.email_field :email, class: "w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>
  <div>
    <%= f.label :address, class: "block text-gray-700 text-sm font-bold mb-2" %>
    <%= f.text_field :address, class: "w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>
  <div>
    <%= f.label :city, class: "block text-gray-700 text-sm font-bold mb-2" %>
    <%= f.text_field :city, class: "w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>
  <div>
    <%= f.label :state, class: "block text-gray-700 text-sm font-bold mb-2" %>
    <%= f.text_field :state, class: "w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>
  <div>
    <%= f.label :country, class: "block text-gray-700 text-sm font-bold mb-2" %>
    <%= f.text_field :country, class: "w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>
  <div>
    <%= f.submit "Update", class: "bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline" %>
  </div>
<% end %>
