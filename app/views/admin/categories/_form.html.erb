<%= form_with model: [:admin, category], local: true, class: "space-y-4" do |form| %>
  <% if category.errors.any? %>
    <div class="bg-red-100 text-red-700 px-4 py-2 rounded">
      <h2 class="font-bold">Errors:</h2>
      <ul class="list-disc list-inside">
        <% category.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :name, class: "mt-1 block w-full border border-gray-300 rounded px-3 py-2 shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
  </div>
  <%= form.submit class: "bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded" %>
<% end %>
