<div class="w-full mx-auto m-10 p-10">
  <div class="flex justify-between items-center pb-6">
    <h1 class="text-3xl text-black">Categories</h1>
    <%= link_to "New Category", new_admin_category_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline" %>
  </div>
  <div class="bg-white overflow-auto rounded-lg shadow">
    <table class="min-w-full bg-white">
      <thead class="bg-gray-200 text-gray-600 uppercase text-sm leading-normal">
        <tr>
          <th class="py-3 px-6 text-left">Name</th>
          <th class="py-3 px-6 text-center">Actions</th>
        </tr>
      </thead>
      <tbody class="text-gray-700 text-sm font-light">
        <% @categories.each do |category| %>
          <tr class="border-b border-gray-200 hover:bg-gray-100">
            <td class="py-3 px-6 text-left whitespace-nowrap"><%= category.name %></td>
            <td class="py-3 px-6 text-center space-x-2">
              <%= link_to "Edit", edit_admin_category_path(category), class: "bg-yellow-500 text-white px-3 py-1 rounded hover:bg-yellow-600 transition" %>
              <%= link_to "Delete", admin_category_path(category), method: :delete, data: { confirm: "Are you sure?" }, class: "bg-red-500 text-white px-3 py-1 rounded hover:bg-red-600 transition" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
