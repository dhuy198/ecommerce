<div class="max-w-4xl mx-auto mt-10">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">Categories</h1>
    <%= link_to "New Category", new_admin_category_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded" %>
  </div>
  <table class="min-w-full bg-white shadow-md rounded overflow-hidden">
    <thead class="bg-gray-100 text-left">
      <tr>
        <th class="px-6 py-3 text-sm font-medium text-gray-600">Name</th>
        <th class="px-6 py-3 text-sm font-medium text-gray-600">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @categories.each do |category| %>
        <tr class="border-t">
          <td class="px-6 py-4"><%= category.name %></td>
          <td class="px-6 py-4 space-x-2">
            <%= link_to "Edit", edit_admin_category_path(category), class: "text-yellow-600 hover:underline" %>
            <%= link_to "Delete", admin_category_path(category), method: :delete, data: { confirm: "Are you sure?" }, class: "text-red-600 hover:underline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
