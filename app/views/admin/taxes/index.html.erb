<div class="w-full mx-auto m-10 p-10">
  <h1 class="text-2xl font-bold text-gray-800 mb-6">Taxes</h1>
  <div class="flex justify-end mb-6">
    <%= link_to "New Tax", new_admin_tax_path, 
          class: "bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg shadow transition" %>
  </div>
  <div class="overflow-x-auto bg-white shadow rounded-lg border border-gray-200">
    <table class="w-full text-sm text-left text-gray-700">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="px-4 py-3 font-medium">Begin</th>
          <th scope="col" class="px-4 py-3 font-medium">End</th>
          <th scope="col" class="px-4 py-3 font-medium">Name</th>
          <th scope="col" class="px-4 py-3 font-medium">Value</th>
          <th scope="col" class="px-4 py-3 font-medium text-center">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @taxes.each do |tax| %>
          <tr class="hover:bg-gray-50 transition">
            <td class="px-4 py-3"><%= tax.begin %></td>
            <td class="px-4 py-3"><%= tax.end %></td>
            <td class="px-4 py-3"><%= tax.name %></td>
            <td class="px-4 py-3"><%= tax.value %></td>
            <td class="px-4 py-3 text-center space-x-2">
              <%= link_to "Show", admin_tax_path(tax), class: "text-blue-600 hover:underline" %>
              <%= link_to "Edit", edit_admin_tax_path(tax), class: "text-yellow-600 hover:underline" %>
              <%= link_to "Delete", admin_tax_path(tax), 
                    method: :delete, 
                    data: { confirm: "Are you sure?" }, 
                    class: "text-red-600 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @taxes.empty? %>
    <p class="text-gray-500 mt-4">No tax records found.</p>
  <% end %>
</div>
