<div class="max-w-2xl mx-auto mt-10 bg-white p-6 rounded shadow">
  <h1 class="text-2xl font-bold mb-4"><%= @tax.name %></h1>
  <div class="space-y-3 text-sm">
    <p><strong>Beign:</strong> <%= @tax.begin %> %</p>
    <p><strong>End:</strong> <%= @tax.end %> %</p>
    <p><strong>Name:</strong> <%= @tax.name %></p>
    <p><strong>Value:</strong> <%= @tax.value %></p>
    <p><strong>Created At:</strong> <%= @tax.created_at.strftime("%Y-%m-%d %H:%M") %></p>
  </div>
  <div class="mt-4">
    <%= link_to "Back", admin_taxes_path, class: "text-gray-600 hover:underline mr-4" %>
    <%= link_to "Edit", edit_admin_tax_path(@tax), class: "text-blue-600 hover:underline mr-4" %>
    <%= button_to "Delete", admin_tax_path(@tax), method: :delete, data: { confirm: "Are you sure?" }, class: "text-red-600 hover:underline" %>
  </div>
</div>
