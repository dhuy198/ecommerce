<div class="w-full mx-auto m-10 p-10">
  <h1 class="text-2xl font-bold text-gray-800 mb-6"><%= @tax.name %></h1>
  <div class="space-y-3 text-gray-700 text-sm">
    <p><strong>Begin:</strong> <%= @tax.begin %></p>
    <p><strong>End:</strong> <%= @tax.end %></p>
    <p><strong>Name:</strong> <%= @tax.name %></p>
    <p><strong>Value:</strong> <%= @tax.value %></p>
    <p><strong>Created At:</strong> <%= @tax.created_at.strftime("%Y-%m-%d %H:%M") %></p>
  </div>
  <div class="mt-6 flex space-x-3">
    <%= link_to "Back", admin_taxes_path, 
          class: "bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg shadow transition" %>
    <%= link_to "Edit", edit_admin_tax_path(@tax), 
          class: "bg-yellow-500 hover:bg-yellow-600 text-white px-4 py-2 rounded-lg shadow transition" %>
    <%= button_to "Delete", admin_tax_path(@tax), 
          method: :delete, 
          data: { confirm: "Are you sure?" }, 
          class: "bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg shadow transition" %>
  </div>
</div>
