<%= form_with model: [:admin, @tax], local: true, class: "space-y-4" do |f| %>
  <% if f.object.errors.any? %>
    <div class="bg-red-100 text-red-700 p-4 rounded">
      <ul class="list-disc pl-5">
        <% f.object.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= f.label :beign, class: "block text-sm font-medium text-gray-700" %>
    <%= f.date_select :begin, {}, class: "w-full mt-1 border px-3 py-2 rounded" %>
  </div>
  <div>
    <%= f.label :end, class: "block text-sm font-medium text-gray-700" %>
    <%= f.date_select :end, {}, class: "w-full mt-1 border px-3 py-2 rounded" %>
  </div>
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :name, class: "w-full mt-1 border px-3 py-2 rounded" %>
  </div>
  <div>
    <%= f.label :value, class: "block text-sm font-medium text-gray-700" %>
    <%= f.number_field :value, step: 0.01, class: "w-full mt-1 border px-3 py-2 rounded" %>
  </div>
  <%= f.submit class: "bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded" %>
<% end %>
