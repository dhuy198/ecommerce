<%= form_with model: [:admin, product], local: true, html: { multipart: true }, class: "space-y-6" do |f| %>
  <% if product.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-lg">
      <h2 class="font-semibold mb-2">Please fix the following errors:</h2>
      <ul class="list-disc pl-5 space-y-1">
        <% product.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :name, class: "mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
  </div>
  <div>
    <%= f.label :description, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :description, rows: 4, class: "mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
  </div>
  <div>
    <%= f.label :price, class: "block text-sm font-medium text-gray-700" %>
    <%= f.number_field :price, step: 0.1, class: "mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
  </div>
  <div>
    <%= f.label :ex_price, class: "block text-sm font-medium text-gray-700" %>
    <%= f.number_field :ex_price, step: 0.1, class: "mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
  </div>
  <div>
    <%= f.label :stock, class: "block text-sm font-medium text-gray-700" %>
    <%= f.number_field :stock, class: "mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
  </div>
  <div>
    <%= f.label :category_id, "Category", class: "block text-sm font-medium text-gray-700" %>
    <%= f.collection_select :category_id, Category.all, :id, :name, 
          { prompt: "Select Category" }, 
          class: "mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
  </div>
  <div>
    <%= f.label :images, "Product Images", class: "block text-sm font-medium text-gray-700" %>
    <%= f.file_field :images, multiple: true, 
          class: "mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
  </div>
  <% if @product.images.attached? %>
    <div class="mt-4">
      <h3 class="text-sm font-medium text-gray-700 mb-2">Current Images</h3>
      <div class="grid grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
        <% @product.images.each do |image| %>
          <div class="flex flex-col items-center space-y-1">
            <%= image_tag image, class: "w-16 h-16 object-contain rounded border" %>
            <label class="text-xs text-gray-600">
              <%= check_box_tag "product[remove_image_ids][]", image.id, false, class: "mr-1" %> Remove
            </label>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
  <div>
    <%= f.submit "Save Product", class: "bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg shadow transition-colors" %>
  </div>
<% end %>
