<%= form_with model: [:admin, product], local: true, html: { multipart: true } do |f| %>
  <% if product.errors.any? %>
    <div class="bg-red-100 text-red-700 p-4 mb-4 rounded">
      <h2 class="font-bold">Errors:</h2>
      <ul>
        <% product.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="mb-4">
    <%= f.label :name, class: "block font-medium" %>
    <%= f.text_field :name, class: "border px-3 py-2 w-full rounded" %>
  </div>
  <div class="mb-4">
    <%= f.label :description, class: "block font-medium" %>
    <%= f.text_area :description, rows: 4, class: "border px-3 py-2 w-full rounded" %>
  </div>
  <div class="mb-4">
    <%= f.label :price, class: "block font-medium" %>
    <%= f.number_field :price, step: 0.01, class: "border px-3 py-2 w-full rounded" %>
  </div>
  <div class="mb-4">
    <%= f.label :stock, class: "block font-medium" %>
    <%= f.number_field :stock, class: "border px-3 py-2 w-full rounded" %>
  </div>
  <div class="mb-4">
    <%= f.label :category_id, "Category", class: "block font-medium" %>
    <%= f.collection_select :category_id, Category.all, :id, :name, { prompt: "Select Category" }, class: "border px-3 py-2 w-full rounded" %>
  </div>
  <%= f.label :images, "Product Images", class: "block font-medium" %>
  <%= f.file_field :images, multiple: true, class: "border px-3 py-2 w-full rounded" %>
  <% @product.images.each do |image| %>
    <div class="grid grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2">
      <%= image_tag image, class: "w-[64px] h-[64px] object-contain rounded" %>
      <label>
        <%= check_box_tag "product[remove_image_ids][]", image.id %> Remove
      </label>
    </div>
  <% end %>
  <%= f.submit class: "bg-green-600 text-white px-4 py-2 rounded" %>
<% end %>
