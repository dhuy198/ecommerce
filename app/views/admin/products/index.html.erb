<h1 class="text-2xl font-bold mb-4">Products</h1>
<%= link_to "New Product", new_admin_product_path, class: "mb-4 inline-block bg-blue-600 text-white px-4 py-2 rounded" %>
<table class="w-full table-auto border-collapse border border-gray-300">
  <thead>
    <tr class="bg-gray-100">
      <th class="border px-4 py-2">Name</th>
      <th class="border px-4 py-2">Price</th>
      <th class="border px-4 py-2">Stock</th>
      <th class="border px-4 py-2">Category</th>
      <th class="border px-4 py-2">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td class="border px-4 py-2"><%= product.name %></td>
        <td class="border px-4 py-2"><%= number_to_currency(product.price) %></td>
        <td class="border px-4 py-2"><%= product.stock %></td>
        <td class="border px-4 py-2"><%= product.category&.name %></td>
        <td class="border px-4 py-2 space-x-2">
          <%= link_to "Show", admin_product_path(product), class: "text-blue-600" %>
          <%= link_to "Edit", edit_admin_product_path(product), class: "text-yellow-600" %>
          <%= link_to "Delete", admin_product_path(product), method: :delete, data: { confirm: "Are you sure?" }, class: "text-red-600" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
