<div class="container mx-auto">
  <h1 class="text-2xl font-bold mb-4"><%= @product.name %></h1>
  <div class="space-y-2 text-gray-800">
    <p><strong>Description:</strong> <%= @product.description %></p>
    <p><strong>Price:</strong> <%= number_to_currency(@product.price) %></p>
    <p><strong>Stock:</strong> <%= @product.stock %></p>
    <p><strong>Category:</strong> <%= @product.category&.name || "N/A" %></p>
  </div>
  <% if @product.images.attached? %>
    <h2 class="mt-6 text-lg font-semibold">Images:</h2>
    <div class="grid grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2">
      <% @product.images.each do |img| %>
        <div class="bg-white p-1 rounded shadow">
          <%= image_tag img, class: "w-[64px] h-[64px] object-contain rounded" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
<div class="mt-6">
  <%= link_to 'Edit', edit_admin_product_path(@product), class: "bg-yellow-500 hover:bg-yellow-600 text-white px-4 py-2 rounded" %>
  <%= link_to 'Back', admin_products_path, class: "bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded" %>
</div>
</div>
