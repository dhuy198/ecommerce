<div class="w-full mx-auto m-10 p-10">
  <h1 class="text-2xl font-bold text-gray-800"><%= @product.name %></h1>
  <div class="space-y-2 text-gray-700">
    <p><span class="font-semibold">Description:</span> <%= @product.description %></p>
    <p><span class="font-semibold">Price:</span> <%= number_to_currency(@product.price) %></p>
    <p><span class="font-semibold">Stock:</span> <%= @product.stock %></p>
    <p><span class="font-semibold">Category:</span> <%= @product.category&.name || "N/A" %></p>
  </div>
  <% if @product.images.attached? %>
    <div>
      <h2 class="text-lg font-semibold text-gray-800 mb-2">Images:</h2>
      <div class="grid grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        <% @product.images.each do |img| %>
          <div class="bg-white p-1 rounded shadow-sm">
            <%= image_tag img, class: "w-20 h-20 object-contain rounded" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
  <div class="flex space-x-3 pt-4">
    <%= link_to 'Edit', edit_admin_product_path(@product), class: "bg-yellow-500 hover:bg-yellow-600 text-white px-4 py-2 rounded transition" %>
    <%= link_to 'Back', admin_products_path, class: "bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded transition" %>
  </div>
</div>
