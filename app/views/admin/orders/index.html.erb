<div class="w-full mx-auto m-10 p-10">
  <h1 class="text-3xl text-black pb-6">Orders Management</h1>
  <!-- Nhóm 2: Các đơn còn lại -->
  <h2 class="text-xl font-semibold text-red-700 mb-3">Other Orders</h2>
  <div class="overflow-x-auto bg-white rounded-lg shadow mb-3">
    <table class="min-w-full text-sm text-left border-collapse">
      <thead class="bg-gray-100 border-b">
        <tr>
          <th class="px-6 py-3 font-medium text-gray-700">ID</th>
          <th class="px-6 py-3 font-medium text-gray-700">User</th>
          <th class="px-6 py-3 font-medium text-gray-700">Total</th>
          <th class="px-6 py-3 font-medium text-gray-700">Payment</th>
          <th class="px-6 py-3 font-medium text-gray-700">Delivery</th>
          <th class="px-6 py-3 font-medium text-gray-700">Method</th>
          <th class="px-6 py-3 font-medium text-gray-700">Address</th>
          <th class="px-6 py-3 font-medium text-gray-700">Created At</th>
          <th class="px-6 py-3 font-medium text-gray-700">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @orders.each do |order| %>
          <% unless order.payment_status == 'paid' && order.deliverd_status == 'delivered' %>
            <tr class="border-t hover:bg-gray-50">
              <td class="px-6 py-4"><%= order.id %></td>
              <td class="px-6 py-4"><%= order.user&.email %></td>
              <td class="px-6 py-4"><%= number_to_currency(order.total) %></td>
              <td class="px-6 py-4"><%= order.payment_status %></td>
              <td class="px-6 py-4"><%= order.deliverd_status %></td>
              <td class="px-6 py-4"><%= order.payment_method.capitalize %></td>
              <td class="px-6 py-4"><%= order.shipping_address %></td>
              <td class="px-6 py-4"><%= order.created_at.strftime("%Y-%m-%d") %></td>
              <td class="px-6 py-4 space-x-2">
                <%= link_to 'Show', admin_order_path(order), class: "text-blue-600 hover:underline" %>
                <%= link_to 'Edit', edit_admin_order_path(order), class: "text-yellow-600 hover:underline" %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
  <!-- Nhóm 1: Đã thanh toán & giao hàng -->
  <h2 class="text-xl font-semibold text-green-700 mb-3">Completed Orders</h2>
  <div class="overflow-x-auto bg-white rounded-lg shadow mb-10">
    <table class="min-w-full text-sm text-left border-collapse">
      <thead class="bg-gray-100 border-b">
        <tr>
          <th class="px-6 py-3 font-medium text-gray-700">ID</th>
          <th class="px-6 py-3 font-medium text-gray-700">User</th>
          <th class="px-6 py-3 font-medium text-gray-700">Total</th>
          <th class="px-6 py-3 font-medium text-gray-700">Payment</th>
          <th class="px-6 py-3 font-medium text-gray-700">Delivery</th>
          <th class="px-6 py-3 font-medium text-gray-700">Method</th>
          <th class="px-6 py-3 font-medium text-gray-700">Address</th>
          <th class="px-6 py-3 font-medium text-gray-700">Created At</th>
          <th class="px-6 py-3 font-medium text-gray-700">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @orders.each do |order| %>
          <% if order.payment_status == 'paid' && order.deliverd_status == 'delivered' %>
            <tr class="border-t hover:bg-gray-50">
              <td class="px-6 py-4"><%= order.id %></td>
              <td class="px-6 py-4"><%= order.user&.email %></td>
              <td class="px-6 py-4"><%= number_to_currency(order.total) %></td>
              <td class="px-6 py-4"><%= order.payment_status %></td>
              <td class="px-6 py-4"><%= order.deliverd_status %></td>
              <td class="px-6 py-4"><%= order.payment_method.capitalize %></td>
              <td class="px-6 py-4"><%= order.shipping_address %></td>
              <td class="px-6 py-4"><%= order.created_at.strftime("%Y-%m-%d") %></td>
              <td class="px-6 py-4 space-x-2">
                <%= link_to 'Show', admin_order_path(order), class: "text-blue-600 hover:underline" %>
                <%= link_to 'Edit', edit_admin_order_path(order), class: "text-yellow-600 hover:underline" %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
