<div class="w-full mx-auto m-10 p-10">
  <h1 class="text-3xl font-semibold mb-6">Order Detail</h1>
  <div class="bg-white shadow-md rounded-lg p-6 space-y-4 text-sm">
    <p><span class="font-medium text-gray-700">User:</span> <%= @order.user&.name || @order.gname || "Guest" %></p>
    <p><span class="font-medium text-gray-700">Total:</span> <%= number_to_currency(@order.total) %></p>
    <p><span class="font-medium text-gray-700">Payment Method:</span> <%= @order.payment_method %></p>
    <p><span class="font-medium text-gray-700">Payment Status:</span> <%= @order.payment_status %></p>
    <p><span class="font-medium text-gray-700">Delivery Status:</span> <%= @order.deliverd_status %></p>
    <p><span class="font-medium text-gray-700">Shipping Address:</span> <%= @order.shipping_address %></p>
    <p><span class="font-medium text-gray-700">Created At:</span> <%= @order.created_at.strftime('%Y-%m-%d %H:%M') %></p>
  </div>
  <!-- Order Items Table -->
  <h2 class="text-xl font-semibold mt-8 mb-4">Order Items</h2>
  <div class="overflow-x-auto bg-white shadow-md rounded-lg">
    <table class="min-w-full border-collapse">
      <thead>
        <tr class="bg-gray-100 text-left text-gray-700 text-sm">
          <th class="px-6 py-3 border-b">Product</th>
          <th class="px-6 py-3 border-b">Image</th>
          <th class="px-6 py-3 border-b">Quantity</th>
          <th class="px-6 py-3 border-b">Price</th>
          <th class="px-6 py-3 border-b">Subtotal</th>
        </tr>
      </thead>
      <tbody>
        <% @order.order_items.each do |item| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 border-b"><%= item.product.name %></td>
            <td class="px-6 py-4 border-b"><%= image_tag item.product.images.first, size: "80x80", class: "rounded-md " %></td>
            <td class="px-6 py-4 border-b"><%= item.quantity %></td>
            <td class="px-6 py-4 border-b"><%= number_to_currency(item.price || item.product.price) %></td>
            <td class="px-6 py-4 border-b">
              <%= number_to_currency((item.price || item.product.price) * item.quantity) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= link_to "Back", admin_orders_path, class: "inline-block mt-6 text-blue-600 hover:underline text-sm" %>
</div>
