<div class="max-w-2xl mx-auto mt-10">
  <h1 class="text-2xl font-bold mb-4">Order Detail</h1>
  <div class="space-y-3 text-sm">
    <p><strong>User:</strong> <%= @order.user.name %></p>
    <p><strong>Total:</strong> <%= number_to_currency(@order.total) %></p>
    <p><strong>Payment Method:</strong> <%= @order.payment_method %></p>
    <p><strong>Payment Status:</strong> <%= @order.payment_status %></p>
    <p><strong>Delivery Status:</strong> <%= @order.deliverd_status %></p>
    <p><strong>Shipping Address:</strong> <%= @order.shipping_address %></p>
    <p><strong>Created At:</strong> <%= @order.created_at.strftime('%Y-%m-%d %H:%M') %></p>
  </div>
  <%= link_to "Back", admin_orders_path, class: "text-gray-600 hover:underline mt-4 inline-block" %>
</div>
