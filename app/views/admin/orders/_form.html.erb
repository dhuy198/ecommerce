<%= form_with model: [:admin, @order], local: true, class: "space-y-6" do |f| %>
  <% if f.object.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-lg">
      <ul class="list-disc pl-5 space-y-1">
        <% f.object.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <!-- Order Info -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :total, "Total", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :total, step: 0.01, disabled: true, 
            class: "mt-1 block w-full border border-gray-300 px-3 py-2 rounded-lg bg-gray-100 text-gray-500" %>
    </div>
    <div>
      <%= f.label :shipping_address, "Shipping Address", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :shipping_address, disabled: true, 
            class: "mt-1 block w-full border border-gray-300 px-3 py-2 rounded-lg bg-gray-100 text-gray-500" %>
    </div>
  </div>
  <!-- Payment -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :payment_status, "Payment Status", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :payment_status, ["paid", "unpaid"], {},
            class: "mt-1 block w-full border border-gray-300 px-3 py-2 rounded-lg" %>
    </div>
    <div>
      <%= f.label :payment_method, "Payment Method", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :payment_method, disabled: true, 
            class: "mt-1 block w-full border border-gray-300 px-3 py-2 rounded-lg bg-gray-100 text-gray-500" %>
    </div>
  </div>
  <!-- Delivery (Editable) -->
  <div>
    <%= f.label :deliverd_status, "Delivered Status", class: "block text-sm font-medium text-gray-700" %>
    <%= f.select :deliverd_status, ["pending", "shipping", "delivered"], {}, 
          class: "mt-1 block w-full border border-gray-300 px-3 py-2 rounded-lg" %>
  </div>
  <!-- Order Items -->
  <div>
    <h3 class="text-lg font-semibold border-b pb-2 mb-4">Order Items</h3>
    <div id="order-items" class="space-y-3">
      <% @order.order_items.each do |item| %>
        <div class="flex space-x-3 items-center">
          <%= text_field_tag nil, item.product.name, disabled: true, 
                class: "block w-2/3 border border-gray-300 px-3 py-2  bg-gray-100 text-gray-500" %>
          <%= image_tag item.product.images.first, size: "40x40", class: "rounded-md "%>
          <%= number_field_tag nil, item.quantity, disabled: true, 
                class: "block w-1/3 border border-gray-300 px-3 py-2 rounded-lg bg-gray-100 text-gray-500" %>
        </div>
      <% end %>
    </div>
  </div>
  <!-- Submit -->
  <div>
    <%= f.submit "Update Status", 
          class: "bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-lg shadow-md transition-colors" %>
  </div>
<% end %>
