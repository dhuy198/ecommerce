<%= form_with model: [:admin, order], local: true, class: "space-y-4" do |f| %>
  <% if order.errors.any? %>
    <div class="bg-red-100 text-red-700 p-4 rounded">
      <ul class="list-disc pl-5">
        <% order.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= f.label :user_id, "User", class: "block text-sm font-medium text-gray-700" %>
    <%= f.collection_select :user_id, User.all, :id, :name, { prompt: "Select User" }, class: "w-full mt-1 border px-3 py-2 rounded" %>
  </div>
  <div>
    <%= f.label :total, class: "block text-sm font-medium text-gray-700" %>
    <%= f.number_field :total, step: 0.01, class: "w-full mt-1 border px-3 py-2 rounded" %>
  </div>
  <div>
    <%= f.label :payment_method, class: "block text-sm font-medium text-gray-700" %>
    <%= f.select :payment_method, ["COD", "Credit Card", "PayPal"], {}, class: "w-full mt-1 border px-3 py-2 rounded" %>
  </div>
  <div>
    <%= f.label :payment_status, class: "block text-sm font-medium text-gray-700" %>
    <%= f.select :payment_status, ["unpaid", "paid"], {}, class: "w-full mt-1 border px-3 py-2 rounded" %>
  </div>
  <div>
    <%= f.label :deliverd_status, class: "block text-sm font-medium text-gray-700" %>
    <%= f.select :deliverd_status, ["pending", "shipped", "delivered"], {}, class: "w-full mt-1 border px-3 py-2 rounded" %>
  </div>
  <div>
    <%= f.label :shipping_address, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :shipping_address, rows: 2, class: "w-full mt-1 border px-3 py-2 rounded" %>
  </div>
  <%= f.submit class: "bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded" %>
<% end %>
