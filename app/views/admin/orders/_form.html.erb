<%= form_with model: [:admin, @order], local: true, class: "space-y-4" do |f| %>
  <% if f.object.errors.any? %>
    <div class="bg-red-100 text-red-700 p-4 rounded">
      <ul class="list-disc pl-5">
        <% f.object.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <!-- User hoặc Guest -->
  <div>
    <%= f.label :gname, "Guest Name", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :gname, class: "w-full mt-1 border px-3 py-2 rounded" %>
  </div>
  <div>
    <%= f.label :gemail, "Guest Email", class: "block text-sm font-medium text-gray-700" %>
    <%= f.email_field :gemail, class: "w-full mt-1 border px-3 py-2 rounded" %>
  </div>
  <div>
    <%= f.label :gphone, "Guest Phone", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :gphone, class: "w-full mt-1 border px-3 py-2 rounded" %>
  </div>
  <div>
    <%= f.label :gaddress, "Guest Address", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :gaddress, class: "w-full mt-1 border px-3 py-2 rounded" %>
  </div>
  <div>
    <%= f.label :gcity, "Guest City", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :gcity, class: "w-full mt-1 border px-3 py-2 rounded" %>
  </div>
  <div>
    <%= f.label :gcountry, "Guest Country", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :gcountry, class: "w-full mt-1 border px-3 py-2 rounded" %>
  </div>
  <!-- Order Items -->
  <h3 class="text-lg font-semibold mt-4">Order Items</h3>
  <div id="order-items">
    <%= f.fields_for :order_items do |item_form| %>
      <div class="flex space-x-2 mb-2">
        <%= item_form.collection_select :product_id, Product.all, :id, :name, {}, class: "border px-2 py-1 rounded w-1/2" %>
        <%= item_form.number_field :quantity, min: 1, class: "border px-2 py-1 rounded w-1/4" %>
      </div>
    <% end %>
  </div>
  <!-- Submit -->
  <%= f.submit "Save Order", class: "bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded" %>
<% end %>
